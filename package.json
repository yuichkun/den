{
  "name": "@denaudio/den",
  "version": "0.0.0",
  "description": "Composable DSP for unworklet (entry gate)",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/den.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@unworklet/core": "0.4.1"
  },
  "devDependencies": {
    "@unworklet/core": "0.4.1",
    "@unworklet/lang": "0.4.1",
    "@unworklet/offline": "0.4.1",
    "@unworklet/test": "0.4.1",
    "@unworklet/unplugin": "0.4.1",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  }
}
