{
  "name": "@denaudio/den",
  "version": "0.0.0",
  "description": "Composable DSP for unworklet (entry gate)",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/den.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js"
    },
    "./lfo": {
      "types": "./dist/lfo.d.ts",
      "import": "./dist/lfo.js"
    },
    "./oscillator": {
      "types": "./dist/oscillator.d.ts",
      "import": "./dist/oscillator.js"
    },
    "./instrument": {
      "types": "./dist/instrument.d.ts",
      "import": "./dist/instrument.js"
    },
    "./delay-fx": {
      "types": "./dist/delay-fx.d.ts",
      "import": "./dist/delay-fx.js"
    },
    "./delay-settings": {
      "types": "./dist/delay-settings.d.ts",
      "import": "./dist/delay-settings.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run && node --test --test-concurrency=1 tests/*.test.mjs && node --test tests/realtime/*.test.mjs",
    "prepack": "npm run build",
    "build:consumer": "node scripts/build-consumer.mjs",
    "build:integration": "node scripts/build-integration.mjs"
  },
  "peerDependencies": {
    "@unworklet/core": "0.4.1"
  },
  "devDependencies": {
    "@unworklet/core": "0.4.1",
    "@unworklet/lang": "0.4.1",
    "@unworklet/offline": "0.4.1",
    "@unworklet/test": "0.4.1",
    "@unworklet/unplugin": "0.4.1",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
