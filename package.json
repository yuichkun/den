{
  "name": "@denaudio/den",
  "version": "0.0.0",
  "description": "Composable DSP modules and instrument/delay engines for unworklet",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuichkun/den.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js"
    },
    "./lfo": {
      "types": "./dist/lfo.d.ts",
      "import": "./dist/lfo.js"
    },
    "./oscillator": {
      "types": "./dist/oscillator.d.ts",
      "import": "./dist/oscillator.js"
    },
    "./instrument": {
      "types": "./dist/instrument.d.ts",
      "import": "./dist/instrument.js"
    },
    "./delay-fx": {
      "types": "./dist/delay-fx.d.ts",
      "import": "./dist/delay-fx.js"
    },
    "./delay-settings": {
      "types": "./dist/delay-settings.d.ts",
      "import": "./dist/delay-settings.js"
    },
    "./filter": {
      "types": "./dist/filter.d.ts",
      "import": "./dist/filter.js"
    },
    "./voice-policy": {
      "types": "./dist/voice-policy.d.ts",
      "import": "./dist/voice-policy.js"
    },
    "./delay-readhead": {
      "types": "./dist/delay-readhead.d.ts",
      "import": "./dist/delay-readhead.js"
    },
    "./instrument-example": {
      "types": "./dist/instrument-example.d.ts",
      "import": "./dist/instrument-example.js"
    },
    "./state-variable-filter": {
      "types": "./dist/state-variable-filter.d.ts",
      "import": "./dist/state-variable-filter.js"
    },
    "./biquad-eq": {
      "types": "./dist/biquad-eq.d.ts",
      "import": "./dist/biquad-eq.js"
    },
    "./crossover": {
      "types": "./dist/crossover.d.ts",
      "import": "./dist/crossover.js"
    },
    "./formant-bank": {
      "types": "./dist/formant-bank.d.ts",
      "import": "./dist/formant-bank.js"
    },
    "./dynamics": {
      "types": "./dist/dynamics.d.ts",
      "import": "./dist/dynamics.js"
    },
    "./drive": {
      "types": "./dist/drive.d.ts",
      "import": "./dist/drive.js"
    },
    "./modulation-fx": {
      "types": "./dist/modulation-fx.d.ts",
      "import": "./dist/modulation-fx.js"
    },
    "./stereo-delay": {
      "types": "./dist/stereo-delay.d.ts",
      "import": "./dist/stereo-delay.js"
    },
    "./reverb": {
      "types": "./dist/reverb.d.ts",
      "import": "./dist/reverb.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./resonator": {
      "types": "./dist/resonator.d.ts",
      "import": "./dist/resonator.js"
    },
    "./modulation": {
      "types": "./dist/modulation.d.ts",
      "import": "./dist/modulation.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && vitest run && node --test --test-concurrency=1 tests/*.test.mjs && node --test tests/realtime/*.test.mjs",
    "prepack": "npm run build",
    "build:consumer": "node scripts/build-consumer.mjs",
    "build:integration": "node scripts/build-integration.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "peerDependencies": {
    "@unworklet/core": "0.4.1"
  },
  "devDependencies": {
    "@unworklet/core": "0.4.1",
    "@unworklet/lang": "0.4.1",
    "@unworklet/offline": "0.4.1",
    "@unworklet/test": "0.4.1",
    "@unworklet/unplugin": "0.4.1",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
